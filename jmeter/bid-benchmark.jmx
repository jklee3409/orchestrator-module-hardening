<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Bid Pure Logic Benchmark | Redis vs DB Lock">
      <stringProp name="TestPlan.comments">Run both bid implementations in one GUI execution with serialized thread groups: CONFIG_VALIDATE -&gt; REDIS_WARMUP -&gt; REDIS_MEASURE -&gt; DB_LOCK_WARMUP -&gt; DB_LOCK_MEASURE. Paste feed ids from jmeter/setup-bid-benchmark.sql output before starting. Warm-up feeds are isolated from measured feeds to avoid JIT/thread initialization noise from polluting the measured comparison. Keep loops at 1 and think time at 0 for pure bid hot path benchmarking.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="protocol" elementType="Argument">
            <stringProp name="Argument.name">protocol</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="host" elementType="Argument">
            <stringProp name="Argument.name">host</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="port" elementType="Argument">
            <stringProp name="Argument.name">port</stringProp>
            <stringProp name="Argument.value">${__P(port,8080)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="connectTimeoutMs" elementType="Argument">
            <stringProp name="Argument.name">connectTimeoutMs</stringProp>
            <stringProp name="Argument.value">${__P(connectTimeoutMs,3000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="responseTimeoutMs" elementType="Argument">
            <stringProp name="Argument.name">responseTimeoutMs</stringProp>
            <stringProp name="Argument.value">${__P(responseTimeoutMs,30000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="jmeterTestKey" elementType="Argument">
            <stringProp name="Argument.name">jmeterTestKey</stringProp>
            <stringProp name="Argument.value">${__P(jmeterTestKey,local-bid-hotpath)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="workloadType" elementType="Argument">
            <stringProp name="Argument.name">workloadType</stringProp>
            <stringProp name="Argument.value">${__P(workloadType,winner)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="bidderCount" elementType="Argument">
            <stringProp name="Argument.name">bidderCount</stringProp>
            <stringProp name="Argument.value">${__P(bidderCount,500)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="bidderInitialPay" elementType="Argument">
            <stringProp name="Argument.name">bidderInitialPay</stringProp>
            <stringProp name="Argument.value">${__P(bidderInitialPay,2000000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="winnerFeedSalesPrice" elementType="Argument">
            <stringProp name="Argument.name">winnerFeedSalesPrice</stringProp>
            <stringProp name="Argument.value">${__P(winnerFeedSalesPrice,10000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="loserSeedBidAmount" elementType="Argument">
            <stringProp name="Argument.name">loserSeedBidAmount</stringProp>
            <stringProp name="Argument.value">${__P(loserSeedBidAmount,10300)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="warmupThreads" elementType="Argument">
            <stringProp name="Argument.name">warmupThreads</stringProp>
            <stringProp name="Argument.value">${__P(warmupThreads,50)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="measureThreads" elementType="Argument">
            <stringProp name="Argument.name">measureThreads</stringProp>
            <stringProp name="Argument.value">${__P(measureThreads,200)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="warmupRampUpSeconds" elementType="Argument">
            <stringProp name="Argument.name">warmupRampUpSeconds</stringProp>
            <stringProp name="Argument.value">${__P(warmupRampUpSeconds,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="measureRampUpSeconds" elementType="Argument">
            <stringProp name="Argument.name">measureRampUpSeconds</stringProp>
            <stringProp name="Argument.value">${__P(measureRampUpSeconds,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="warmupLoops" elementType="Argument">
            <stringProp name="Argument.name">warmupLoops</stringProp>
            <stringProp name="Argument.value">${__P(warmupLoops,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="measureLoops" elementType="Argument">
            <stringProp name="Argument.name">measureLoops</stringProp>
            <stringProp name="Argument.value">${__P(measureLoops,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="winnerBidStartAmount" elementType="Argument">
            <stringProp name="Argument.name">winnerBidStartAmount</stringProp>
            <stringProp name="Argument.value">${__P(winnerBidStartAmount,10100)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="bidIncrement" elementType="Argument">
            <stringProp name="Argument.name">bidIncrement</stringProp>
            <stringProp name="Argument.value">${__P(bidIncrement,100)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="fixedBidAmount" elementType="Argument">
            <stringProp name="Argument.name">fixedBidAmount</stringProp>
            <stringProp name="Argument.value">${__P(fixedBidAmount,10200)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="thinkMs" elementType="Argument">
            <stringProp name="Argument.name">thinkMs</stringProp>
            <stringProp name="Argument.value">${__P(thinkMs,0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="thinkRangeMs" elementType="Argument">
            <stringProp name="Argument.name">thinkRangeMs</stringProp>
            <stringProp name="Argument.value">${__P(thinkRangeMs,0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="redisUsersCsv" elementType="Argument">
            <stringProp name="Argument.name">redisUsersCsv</stringProp>
            <stringProp name="Argument.value">${__P(redisUsersCsv,redis-bidders.csv)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="dbLockUsersCsv" elementType="Argument">
            <stringProp name="Argument.name">dbLockUsersCsv</stringProp>
            <stringProp name="Argument.value">${__P(dbLockUsersCsv,db-lock-bidders.csv)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="redisWarmupWinnerFeedId" elementType="Argument">
            <stringProp name="Argument.name">redisWarmupWinnerFeedId</stringProp>
            <stringProp name="Argument.value">${__P(redisWarmupWinnerFeedId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="redisWarmupLoserFeedId" elementType="Argument">
            <stringProp name="Argument.name">redisWarmupLoserFeedId</stringProp>
            <stringProp name="Argument.value">${__P(redisWarmupLoserFeedId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="redisWinnerFeedId" elementType="Argument">
            <stringProp name="Argument.name">redisWinnerFeedId</stringProp>
            <stringProp name="Argument.value">${__P(redisWinnerFeedId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="redisLoserFeedId" elementType="Argument">
            <stringProp name="Argument.name">redisLoserFeedId</stringProp>
            <stringProp name="Argument.value">${__P(redisLoserFeedId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="dbLockWarmupWinnerFeedId" elementType="Argument">
            <stringProp name="Argument.name">dbLockWarmupWinnerFeedId</stringProp>
            <stringProp name="Argument.value">${__P(dbLockWarmupWinnerFeedId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="dbLockWarmupLoserFeedId" elementType="Argument">
            <stringProp name="Argument.name">dbLockWarmupLoserFeedId</stringProp>
            <stringProp name="Argument.value">${__P(dbLockWarmupLoserFeedId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="dbLockWinnerFeedId" elementType="Argument">
            <stringProp name="Argument.name">dbLockWinnerFeedId</stringProp>
            <stringProp name="Argument.value">${__P(dbLockWinnerFeedId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="dbLockLoserFeedId" elementType="Argument">
            <stringProp name="Argument.name">dbLockLoserFeedId</stringProp>
            <stringProp name="Argument.value">${__P(dbLockLoserFeedId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="simpleDataWriterFile" elementType="Argument">
            <stringProp name="Argument.name">simpleDataWriterFile</stringProp>
            <stringProp name="Argument.value">${__P(simpleDataWriterFile,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <stringProp name="HTTPSampler.connect_timeout">${connectTimeoutMs}</stringProp>
        <stringProp name="HTTPSampler.response_timeout">${responseTimeoutMs}</stringProp>
        <stringProp name="HTTPSampler.domain">${host}</stringProp>
        <stringProp name="HTTPSampler.port">${port}</stringProp>
        <stringProp name="HTTPSampler.protocol">${protocol}</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.implementation"></stringProp>
      </ConfigTestElement>
      <hashTree/>
      <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="HTTP Cookie Manager" enabled="true">
        <collectionProp name="CookieManager.cookies"/>
        <boolProp name="CookieManager.clearEachIteration">false</boolProp>
        <boolProp name="CookieManager.controlledByThreadGroup">false</boolProp>
      </CookieManager>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="CONFIG_VALIDATE" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Validate Benchmark Configuration" enabled="true">
          <stringProp name="cacheKey">bid-benchmark-validate</stringProp>
          <stringProp name="filename">bid-benchmark-validate.groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="REDIS_WARMUP" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${warmupThreads}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${warmupRampUpSeconds}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${warmupLoops}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Redis Bidder CSV" enabled="true">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${redisUsersCsv}</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <stringProp name="shareMode">shareMode.group</stringProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="variableNames">email,password</stringProp>
        </CSVDataSet>
        <hashTree/>
        <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="Global Bid Sequence" enabled="true">
          <stringProp name="CounterConfig.start">1</stringProp>
          <stringProp name="CounterConfig.end"></stringProp>
          <stringProp name="CounterConfig.incr">1</stringProp>
          <stringProp name="CounterConfig.name">globalBidSeq</stringProp>
          <stringProp name="CounterConfig.format"></stringProp>
          <boolProp name="CounterConfig.per_user">false</boolProp>
        </CounterConfig>
        <hashTree/>
        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Client Think Time" enabled="true">
          <stringProp name="ConstantTimer.delay">${thinkMs}</stringProp>
          <stringProp name="RandomTimer.range">${thinkRangeMs}</stringProp>
        </UniformRandomTimer>
        <hashTree/>
        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Synchronizing Timer" enabled="true">
          <intProp name="groupSize">0</intProp>
          <longProp name="timeoutInMs">45000</longProp>
        </SyncTimer>
        <hashTree/>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="REDIS | WARMUP | POST ONLY" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Place Bid" enabled="true">
            <stringProp name="HTTPSampler.path">${bidPath}</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;transactionFeedId&quot;: ${feedId}, &quot;bidAmount&quot;: ${bidAmount}}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Prepare Request" enabled="true">
              <stringProp name="cacheKey">bid-benchmark-prepare-request</stringProp>
              <stringProp name="filename">bid-benchmark-prepare-request.groovy</stringProp>
              <stringProp name="parameters">redis,warmup,${redisWarmupWinnerFeedId},${redisWarmupLoserFeedId}</stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bid Headers" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="Content-Type" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
                <elementProp name="Accept" elementType="Header">
                  <stringProp name="Header.name">Accept</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
                <elementProp name="Authorization" elementType="Header">
                  <stringProp name="Header.name">Authorization</stringProp>
                  <stringProp name="Header.value">Bearer ${authToken}</stringProp>
                </elementProp>
                <elementProp name="X-JMeter-Test-Key" elementType="Header">
                  <stringProp name="Header.name">X-JMeter-Test-Key</stringProp>
                  <stringProp name="Header.value">${jmeterTestKey}</stringProp>
                </elementProp>
                <elementProp name="X-Benchmark-Case" elementType="Header">
                  <stringProp name="Header.name">X-Benchmark-Case</stringProp>
                  <stringProp name="Header.value">${benchmarkCase}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Classify Response" enabled="true">
              <stringProp name="cacheKey">bid-benchmark-classify-response</stringProp>
              <stringProp name="filename">bid-benchmark-classify-response.groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="REDIS_MEASURE" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${measureThreads}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${measureRampUpSeconds}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${measureLoops}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Redis Bidder CSV" enabled="true">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${redisUsersCsv}</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <stringProp name="shareMode">shareMode.group</stringProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="variableNames">email,password</stringProp>
        </CSVDataSet>
        <hashTree/>
        <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="Global Bid Sequence" enabled="true">
          <stringProp name="CounterConfig.start">1</stringProp>
          <stringProp name="CounterConfig.end"></stringProp>
          <stringProp name="CounterConfig.incr">1</stringProp>
          <stringProp name="CounterConfig.name">globalBidSeq</stringProp>
          <stringProp name="CounterConfig.format"></stringProp>
          <boolProp name="CounterConfig.per_user">false</boolProp>
        </CounterConfig>
        <hashTree/>
        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Client Think Time" enabled="true">
          <stringProp name="ConstantTimer.delay">${thinkMs}</stringProp>
          <stringProp name="RandomTimer.range">${thinkRangeMs}</stringProp>
        </UniformRandomTimer>
        <hashTree/>
        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Synchronizing Timer" enabled="true">
          <intProp name="groupSize">0</intProp>
          <longProp name="timeoutInMs">45000</longProp>
        </SyncTimer>
        <hashTree/>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="REDIS | MEASURE | POST ONLY" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Place Bid" enabled="true">
            <stringProp name="HTTPSampler.path">${bidPath}</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;transactionFeedId&quot;: ${feedId}, &quot;bidAmount&quot;: ${bidAmount}}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Prepare Request" enabled="true">
              <stringProp name="cacheKey">bid-benchmark-prepare-request</stringProp>
              <stringProp name="filename">bid-benchmark-prepare-request.groovy</stringProp>
              <stringProp name="parameters">redis,measure,${redisWinnerFeedId},${redisLoserFeedId}</stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bid Headers" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="Content-Type" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
                <elementProp name="Accept" elementType="Header">
                  <stringProp name="Header.name">Accept</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
                <elementProp name="Authorization" elementType="Header">
                  <stringProp name="Header.name">Authorization</stringProp>
                  <stringProp name="Header.value">Bearer ${authToken}</stringProp>
                </elementProp>
                <elementProp name="X-JMeter-Test-Key" elementType="Header">
                  <stringProp name="Header.name">X-JMeter-Test-Key</stringProp>
                  <stringProp name="Header.value">${jmeterTestKey}</stringProp>
                </elementProp>
                <elementProp name="X-Benchmark-Case" elementType="Header">
                  <stringProp name="Header.name">X-Benchmark-Case</stringProp>
                  <stringProp name="Header.value">${benchmarkCase}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Classify Response" enabled="true">
              <stringProp name="cacheKey">bid-benchmark-classify-response</stringProp>
              <stringProp name="filename">bid-benchmark-classify-response.groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="DB_LOCK_WARMUP" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${warmupThreads}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${warmupRampUpSeconds}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${warmupLoops}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
